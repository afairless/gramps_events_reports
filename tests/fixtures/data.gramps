  <notes>
    <note handle="_103fab4fd3cc6058c62f696a818e" change="1786564311" id="N0000" type="Person Note">
      <text>The great patriarchal cat</text>
    </note>
    <note handle="_103fab53d471175f5965d850233d" change="1786564338" id="N0001" type="Person Note">
      <text>Kingly, but a bit mad</text>
    </note>
    <note handle="_103fab59a9025018f8277dcc961a" change="1786564376" id="N0002" type="Person Note">
      <text>He who can defeat The One Who Must Not Be Named</text>
    </note>
    <note handle="_103fab5cfbab22bc977e7588d482" change="1786564398" id="N0003" type="Person Note">
      <text>Very cuddly</text>
    </note>
    <note handle="_103fab660fb9582b63c5d4b7f3ea" change="1786564457" id="N0004" type="Person Note">
      <text>Never overlooked a clean carpet</text>
    </note>
  </notes>
